FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType  RAS;

RAS
{
{% if turbulence_model | default("kOmegaSST") == "kOmegaSSTLM" %}
    RASModel        kOmegaSSTLM;
{% else %}
    RASModel        kOmegaSST;
{% endif %}
    turbulence      on;
    printCoeffs     on;

    // Floor on k to avoid division blow-ups; must stay well below the
    // physical k level (~1e-3 for indoor natural convection) so it does
    // not artificially sustain turbulence
    kMin            1e-4;
}
