FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}

{% if buoyancy_production | default(true) %}
buoyancyProduction
{
    type            scalarCodedSource;
    name            buoyancyProductionK;
    active          true;
    selectionMode   all;

    scalarCodedSourceCoeffs
    {
        selectionMode   all;
        fields          (k);

        codeInclude
        #{
            #include "fvCFD.H"
        #};

        codeCorrect
        #{
        #};

        // Compressible solvers (buoyant*Foam) call the rho-variant addSup;
        // codeAddSup is only for incompressible solvers and is never invoked
        // here. Leaving it empty is intentional.
        codeAddSup
        #{
        #};

        codeAddSupRho
        #{
            // Buoyancy production/destruction term G_b for k-equation
            // G_b = -(mu_t / (rho * Pr_t)) * (g & grad(rho))
            //     = -(nu_t / Pr_t) * (g & grad(rho))   [since mu_t = rho*nu_t]
            // Stable stratification (hot above cold) -> suppresses turbulence
            // Unstable stratification (cold above hot) -> enhances turbulence
            // NOTE: fvc::grad(rho) is valid for multiComponentMixture too,
            // because rho already accounts for composition (Y_i) effects
            // via the equation of state in thermophysicalProperties.
            // The solver registers "nut" (kinematic); "mut" is not guaranteed
            // to exist, so look up nut and avoid the rho division entirely.
            // rho is the addSup(rho, eqn, fieldi) argument.
            const volScalarField& nut =
                mesh_.lookupObject<volScalarField>("nut");
            // g is registered on the Time database, not the mesh registry
            const uniformDimensionedVectorField& g =
                mesh_.time().lookupObject<uniformDimensionedVectorField>("g");
            const scalar Prt = 0.85;

            volScalarField Gb
            (
                "Gb",
                -(nut / Prt) * (g & fvc::grad(rho))
            );

            // Explicit source: add Gb directly to k equation RHS.
            // Simpler and avoids division by k (which can be zero at startup).
            eqn += Gb;
        #};

        codeConstrain
        #{
        #};
    }
}
{% endif %}

{% if aufguss_enabled %}
aufgussJet
{
    type            vectorCodedSource;
    active          true;
    selectionMode   cellZone;
    cellZone        aufgussZone;

    vectorCodedSourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        aufgussZone;
        fields          (U);

        codeInclude
        #{
            #include "fvCFD.H"
        #};

        codeCorrect
        #{
        #};

        // Compressible solvers call the rho-variant addSup; codeAddSup is
        // never invoked here (see buoyancyProduction above).
        codeAddSup
        #{
        #};

        codeAddSupRho
        #{
            // Aufguss jet: downward momentum in the aufguss zone
            // Simulates towel waving creating a directed air jet.
            // Body force per unit volume f = rho * a with acceleration
            // a = jetVelocity / duration [m/s^2], so the matrix source
            // contribution is f * V with dimensions [kg m / s^2].
            const scalar jetVelocity = {{ aufguss_jet_velocity }};  // m/s
            const scalar jetAccel = jetVelocity / {{ aufguss_duration }};  // m/s^2
            const scalar jetDirection = -1.0;  // downward (y-direction)

            // rho is the addSup(rho, eqn, fieldi) argument
            vectorField& USource = eqn.source();
            const scalarField& V = mesh_.V();

            forAll(cells, i)
            {
                label cellI = cells[i];
                // fvMatrix::source() uses residual-form sign convention:
                // subtract f*V to apply a force in +f direction
                USource[cellI][1] -= jetDirection * rho[cellI] * jetAccel * V[cellI];
            }
        #};

        codeConstrain
        #{
        #};
    }
}
{% endif %}

{% if heater_model | default("surface_flux") == "volume_source" %}
heaterSource
{
    type            scalarSemiImplicitSource;
    active          true;
    selectionMode   cellZone;
    cellZone        heaterZone;

    scalarSemiImplicitSourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        heaterZone;
        volumeMode      specific;

        sources
        {
            // Power per unit volume [W/m3]
            // = total_power / (depth * height * width)
            h           ({{ heater_power_density }} 0);
        }
    }
}
{% endif %}

{% if not (buoyancy_production | default(true)) and not aufguss_enabled and heater_model | default("surface_flux") != "volume_source" %}
// No fvOptions active
{% endif %}
