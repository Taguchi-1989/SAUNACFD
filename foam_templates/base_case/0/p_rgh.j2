FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    "(floor|ceiling|heater_wall|heater_wall_surround|opposite_wall|front|back)"
    {
        type            fixedFluxPressure;
        value           uniform 101325;
    }
{% if ventilation | default(false) %}
    supply_vent
    {
{% if supply_velocity | default(0) > 0 %}
        // Velocity-driven inlet: pressure must be flux-consistent, not fixed.
        // totalPressure here + totalPressure at exhaust leaves the pressure
        // field indeterminate and fights pRefCell.
        type            fixedFluxPressure;
        value           uniform 101325;
{% else %}
        type            totalPressure;
        p0              uniform 101325;
        value           uniform 101325;
{% endif %}
    }
    exhaust_vent
    {
        // Single pressure reference for the domain
        type            totalPressure;
        p0              uniform 101325;
        value           uniform 101325;
    }
{% endif %}
}
