FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      H2O;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform {{ Y_H2O_initial | default(0.01) }};

boundaryField
{
    // heater_wall included: a fixedValue there acts as an unbounded vapor
    // source/sink. Loyly steam should be injected via an fvOptions cellZone
    // source, not a wall BC.
    "(floor|ceiling|heater_wall|heater_wall_surround|opposite_wall|front|back)"
    {
        type            zeroGradient;
    }
{% if ventilation | default(false) %}
    supply_vent
    {
        type            inletOutlet;
        inletValue      uniform {{ Y_H2O_initial | default(0.01) }};
        value           uniform {{ Y_H2O_initial | default(0.01) }};
    }
    exhaust_vent
    {
        type            inletOutlet;
        inletValue      uniform {{ Y_H2O_initial | default(0.01) }};
        value           uniform {{ Y_H2O_initial | default(0.01) }};
    }
{% endif %}
}
